# Copy this file to .env for local development.
# Do not commit your real .env file.

SECRET_KEY=change-this-secret-key
FLASK_APP=run.py
FLASK_DEBUG=1

# Default local development database. Later chunks will add database models.
SQLITE_DB_PATH=mediqueue.db

# Optional MySQL example for later deployment/local DB testing:
# DATABASE_URL=mysql+pymysql://mediqueue:mediqueue_password@localhost:3306/mediqueue
